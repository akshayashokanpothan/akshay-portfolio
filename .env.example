# Connection Jobs - Supabase Environment Variables Example
# Duplicate this file as .env.local and populate with your project credentials.

# 1. Supabase Project URL (Public)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Anon Key (Public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-placeholder

# 3. Supabase Service Role Key (Private - Server Only, NEVER expose in client bundles)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-placeholder
